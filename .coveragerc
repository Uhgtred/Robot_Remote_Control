[run]
branch = True
source = /app

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
    except ImportError:
    
omit =
    */test_*.py
    */tests/*
    */UnitTests/*
    */__pycache__/*
    setup.py

[html]
directory = coverage_html